<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "subatomic_particles/modal", subatomic_particle: @subatomic_particle %>
<% else %>
  <% content_for :title, "#{@subatomic_particle.name} | Subatomic Particles | Physicist" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@subatomic_particle) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Subatomic Particles", subatomic_particles_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <%= link_to "Browse Quantum States →", quantum_states_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600"><%= @subatomic_particle.particle_group.name %></p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900"><%= @subatomic_particle.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @subatomic_particle.description %></p>

      <% if @subatomic_particle.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Themes for <%= @subatomic_particle.name %>">
          <% @subatomic_particle.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "subatomic_particles/quantum_states_section", subatomic_particle: @subatomic_particle %>

    <%= render "shared/embedding_panel",
               record: @subatomic_particle,
               action_path: generate_embedding_subatomic_particle_path(@subatomic_particle),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
